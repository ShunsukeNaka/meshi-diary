# cp .env.example .env して値を入れる。.env は git に含めない。
# 値に & などの記号が入るので、シングルクォートで囲む。

# Apache から転送されたリクエストだけを受けるため、既定は 127.0.0.1
LISTEN_ADDR='127.0.0.1:8080'

# Neon の接続文字列（Neon のコンソールの Connection string）
DATABASE_URL='postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require'

# Cloudflare R2
# アカウント ID: R2 の概要ページの「アカウント ID」（32 文字）。API トークンの cfat_... ではない
R2_ACCOUNT_ID=''
# R2 > API トークンの管理 で発行したアクセスキー ID とシークレットアクセスキー
R2_ACCESS_KEY_ID=''
R2_SECRET_ACCESS_KEY=''
# 写真を保存するバケットの名前
R2_BUCKET=''

# ログイン（docs/api.md の「認証」）
# Google Cloud コンソールで作った OAuth クライアント ID。ID トークンの aud の検証に使う
GOOGLE_CLIENT_ID=''
# セッション Cookie の署名に使う秘密鍵（32 バイト以上のランダムな値）。openssl rand -base64 32 で作る
SESSION_SECRET=''
# /signup できるメールアドレス（カンマ区切り）
ALLOWED_EMAILS=''
