                </mxCell>
                <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" value="meshi-diary ドメインモデル（要件整理）" vertex="1">
                    <mxGeometry height="40" width="600" x="20" y="10" as="geometry"/>
                </mxCell>
                <mxCell id="g-diary" parent="1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;fontSize=14;fontStyle=1;" value="Diary 集約" vertex="1">
                    <mxGeometry height="640" width="480" x="20" y="60" as="geometry"/>
                </mxCell>
                <mxCell id="diary" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;p style=&quot;margin:0px;margin-top:6px;text-align:center;&quot;&gt;&lt;b&gt;Diary（日記）&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;項目&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;・ID：日記のID&lt;br&gt;・日付：日記の該当日&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;・種類&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;：朝ごはんか昼ご飯かなど&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;・食事情報：食事をした場所や食べたもの&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;・本文：日記の文章&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;・写真：&amp;lt;Photo&amp;gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;・書いた人：&amp;lt;User&amp;gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;ルール&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;・ID：一意になるID。UUID&lt;br&gt;・日付：JST　YY-MM-DD&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;・種類：朝、昼、晩、その他&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;・&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;食事情報：nullable、文字数制限なし。&lt;/span&gt;&lt;br&gt;・本文：&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;文字数制限なし、一文字以上（空白除く）、通常のテキスト&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;・写真：0～10枚、Photoに準ずる、nullable、表示順は固定で指定できる。&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;・書いた人：Userに準ずる&lt;/p&gt;" vertex="1">
                    <mxGeometry height="290" width="420" x="50" y="100" as="geometry"/>
                </mxCell>
                <mxCell id="photo" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;p style=&quot;margin:0px;margin-top:6px;text-align:center;&quot;&gt;&lt;b&gt;Photo（写真）&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;項目&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;・ID：写真のID&lt;br&gt;・形式：.webP&lt;br&gt;・サイズ：保存容量。縦横を決めるわけではない&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;・写真の説明：写真についてメモしたいことがあれば書く&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;ルール&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;・ID：一意になるID&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: rgb(63, 63, 63);&quot;&gt;・&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: rgb(63, 63, 63);&quot;&gt;形式：.webP&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;・&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;サイズ：1 バイト〜10 MB&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;・写真の説明：nullable&lt;/span&gt;&lt;/p&gt;" vertex="1">
                    <mxGeometry height="220" width="420" x="50" y="450" as="geometry"/>
                </mxCell>
                <mxCell id="g-user" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;fontSize=14;fontStyle=1;" value="User 集約" vertex="1">
                    <mxGeometry height="220" width="360" x="540" y="60" as="geometry"/>
                </mxCell>
                <mxCell id="user" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;p style=&quot;margin:0px;margin-top:6px;text-align:center;&quot;&gt;&lt;b&gt;User（ユーザー）&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;項目&lt;/b&gt;&lt;br&gt;・Googleアカウント：OAuthで使用するアカウント&lt;br&gt;・名前：表示される名前&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;ルール&lt;/b&gt;&lt;br&gt;・Googleアカウント：特に縛りはない。一意。&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;・名前：文字列。20文字以内。&lt;/p&gt;" vertex="1">
